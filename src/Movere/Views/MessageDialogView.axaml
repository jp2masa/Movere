<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Movere"
             xmlns:conv="using:Movere.Converters"
             xmlns:vm="using:Movere.ViewModels"
             x:Class="Movere.Views.MessageDialogView"
             x:DataType="vm:MessageDialogViewModel"
             MaxWidth="512">
    <UserControl.Resources>
        <conv:BitmapConverter x:Key="BitmapConverter" />
    </UserControl.Resources>

    <DockPanel Margin="4">

        <Image DockPanel.Dock="Left"
               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
               Margin="4"
               VerticalAlignment="Top"
               Width="48"
               Height="48"
               Source="{Binding Icon, Converter={StaticResource BitmapConverter}}" />

        <TextBlock Margin="4"
                   VerticalAlignment="Stretch"
                   Text="{local:LocalizedString {Binding Message}}"
                   TextWrapping="Wrap" />

    </DockPanel>

</UserControl>
